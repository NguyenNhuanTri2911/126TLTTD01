<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvThongTinSinhVien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THONG TIN SINH VIEN\nHo ten: Nguyen Nhuan Tri\nMa sinh vien: 2415141122122\nLop HP: 24SK1"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUAN LY CONG VIEC"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/edtTenCongViec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhap ten cong viec"
            android:inputType="textCapSentences"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/edtMoTa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhap mo ta cong viec"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnTaoCongViec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tao cong viec"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnXemDanhSach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xem danh sach cong viec"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>